<Page
    x:Class="ComfyUICaptioningTool.Views.Pages.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:ComfyUICaptioningTool.Helpers"
    xmlns:local="clr-namespace:ComfyUICaptioningTool.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:ComfyUICaptioningTool.Models"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="GalleryPage"
    d:DataContext="{d:DesignInstance local:GalleryPage, IsDesignTimeCreatable=False}"
    d:DesignHeight="800"
    d:DesignWidth="1000"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <Grid Margin="16,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- タイトル -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,12"
            FontSize="20"
            FontWeight="SemiBold"
            Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Gallery_Title]}" />

        <!-- 対象ディレクトリ選択カード -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,8"
            Padding="12"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,4"
                    FontSize="12"
                    Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Main_DirectoryLabel]}" />
                <Grid
                    Grid.Row="1"
                    Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:TextBox
                        Grid.Column="0"
                        Height="36"
                        IsReadOnly="True"
                        PlaceholderText="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Main_DirectoryPlaceholder]}"
                        Text="{Binding ViewModel.TargetDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button
                        Grid.Column="1"
                        Width="36"
                        Height="36"
                        Margin="12,0,0,0"
                        Appearance="Secondary"
                        Command="{Binding ViewModel.BrowseDirectoryCommand}"
                        Icon="{ui:SymbolIcon FolderOpen16}"
                        ToolTip="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Common_BrowseButtonTooltip]}" />
                </Grid>
                <CheckBox
                    Grid.Row="2"
                    Margin="0,0,0,8"
                    Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Main_RecursiveLabel]}"
                    IsChecked="{Binding ViewModel.Recursive, Mode=TwoWay}" />
                <ui:Button
                    Grid.Row="3"
                    Appearance="Primary"
                    Command="{Binding ViewModel.LoadCommand}"
                    Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Gallery_LoadButtonContent]}"
                    Icon="{ui:SymbolIcon ImageMultiple24}" />
            </Grid>
        </Border>

        <!-- 一括タグ操作カード -->
        <Border
            Grid.Row="2"
            Margin="0,0,0,8"
            Padding="12"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,4"
                    FontSize="12"
                    Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Gallery_BulkTagSectionLabel]}" />
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBox
                        Grid.Column="0"
                        Height="36"
                        PlaceholderText="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Gallery_BulkTagPlaceholder]}"
                        Text="{Binding ViewModel.BulkTagInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button
                        Grid.Column="1"
                        Height="36"
                        Margin="12,0,0,0"
                        Appearance="Secondary"
                        Command="{Binding ViewModel.BulkAddTagCommand}"
                        Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Gallery_BulkAddButtonContent]}" />
                    <ui:Button
                        Grid.Column="2"
                        Height="36"
                        Margin="12,0,0,0"
                        Appearance="Secondary"
                        Command="{Binding ViewModel.BulkRemoveTagCommand}"
                        Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Gallery_BulkRemoveButtonContent]}" />
                </Grid>
            </Grid>
        </Border>

        <!-- 読み込み中インジケーター -->
        <ProgressBar
            Grid.Row="3"
            Height="4"
            IsIndeterminate="True"
            Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- 状態メッセージ -->
        <TextBlock
            Grid.Row="4"
            Margin="0,8,0,0"
            HorizontalAlignment="Center"
            FontSize="14"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding ViewModel.StatusMessage, Mode=OneWay}"
            Visibility="{Binding ViewModel.StatusMessage, Converter={StaticResource StringToVisibilityConverter}}" />

        <!-- 画像・タグ一覧 -->
        <ScrollViewer
            Grid.Row="5"
            Margin="0,8,0,0"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ViewModel.Images, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:GalleryImageEntry}">
                        <Border
                            Margin="0,0,0,8"
                            Padding="8"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            ClipToBounds="True"
                            CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- サムネイル（読み込み失敗時はプレースホルダーアイコン） -->
                                <Image
                                    Grid.Column="0"
                                    Grid.Row="0"
                                    Width="192"
                                    Height="192"
                                    Source="{Binding Thumbnail}"
                                    Stretch="Uniform">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <ui:SymbolIcon
                                    Grid.Column="0"
                                    Grid.Row="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="48"
                                    Foreground="{DynamicResource TextFillColorDisabledBrush}"
                                    Symbol="Image24">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>

                                <!-- ファイル名 -->
                                <TextBlock
                                    Grid.Column="0"
                                    Grid.Row="1"
                                    Margin="0,8,0,4"
                                    FontWeight="Medium"
                                    Text="{Binding FileName}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding FileName}" />

                                <!-- タグ一覧 -->
                                <ScrollViewer
                                    Grid.Column="1"
                                    Grid.Row="0"
                                    VerticalScrollBarVisibility="Auto">
                                    <ItemsControl
                                        ItemsSource="{Binding Tags}"
                                        Visibility="{Binding HasTags, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Margin="0,0,4,4"
                                                    Padding="4,2"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    CornerRadius="8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock
                                                            FontSize="12"
                                                            Text="{Binding}"
                                                            TextWrapping="Wrap"
                                                            VerticalAlignment="Center" />
                                                        <ui:Button
                                                            Width="18"
                                                            Height="18"
                                                            Margin="4,0,0,0"
                                                            Padding="0"
                                                            Appearance="Transparent"
                                                            Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Content="×"
                                                            FontSize="12"
                                                            ToolTip="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Gallery_RemoveTagTooltip]}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock
                                    Grid.Column="1"
                                    Grid.Row="0"
                                    FontSize="12"
                                    FontStyle="Italic"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Gallery_NoTagsLabel]}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasTags}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- タグ追加入力欄 -->
                                <Grid
                                    Grid.Column="1"
                                    Grid.Row="1"
                                    Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ui:TextBox
                                        Grid.Column="0"
                                        Height="36"
                                        FontSize="12"
                                        PlaceholderText="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Gallery_AddTagPlaceholder]}"
                                        Text="{Binding NewTagInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <ui:TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding AddNewTagCommand}" />
                                        </ui:TextBox.InputBindings>
                                    </ui:TextBox>
                                    <ui:Button
                                        Grid.Column="1"
                                        Width="36"
                                        Height="36"
                                        Margin="8,0,0,0"
                                        Appearance="Secondary"
                                        Command="{Binding AddNewTagCommand}"
                                        Icon="{ui:SymbolIcon AddCircle24}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
