<Page
    x:Class="ComfyUICaptioningTool.Views.Pages.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:ComfyUICaptioningTool.Helpers"
    xmlns:local="clr-namespace:ComfyUICaptioningTool.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:ComfyUICaptioningTool.Models"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="GalleryPage"
    d:DataContext="{d:DesignInstance local:GalleryPage, IsDesignTimeCreatable=False}"
    d:DesignHeight="800"
    d:DesignWidth="1000"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <helpers:TagExistsToBoolean x:Key="TagExistsToBoolean"/>
        <helpers:TagInCollectionConverter x:Key="TagInCollectionConverter"/>
        <helpers:ObjectEqualsConverter x:Key="ObjectEqualsConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- タグ名ボタン（トグルボタン）。選択中はアクセントカラーで強調表示する -->
        <Style x:Key="TagToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 画像タイル（トグルボタン）。選択中はボーダーをアクセントカラーで強調表示する -->
        <Style x:Key="ImageTileToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <!-- BorderThickness はチェック状態にかかわらず常に固定値とする。トリガーで太さを変えると
                 Border の外形サイズ（延いては WrapPanel 上の他タイルの位置）がずれてしまうため、
                 選択の強調表示は色の変更のみで行う -->
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="16,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- タイトル -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,12"
            FontSize="20"
            FontWeight="SemiBold"
            Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Gallery_Title]}" />

        <!-- 対象ディレクトリ選択カード -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,8"
            Padding="12"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,4"
                    FontSize="12"
                    Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Main_DirectoryLabel]}" />
                <Grid
                    Grid.Row="1"
                    Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:TextBox
                        Grid.Column="0"
                        Height="36"
                        IsReadOnly="True"
                        PlaceholderText="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Main_DirectoryPlaceholder]}"
                        Text="{Binding ViewModel.TargetDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button
                        Grid.Column="1"
                        Width="36"
                        Height="36"
                        Margin="12,0,0,0"
                        Appearance="Secondary"
                        Command="{Binding ViewModel.BrowseDirectoryCommand}"
                        Icon="{ui:SymbolIcon FolderOpen16}"
                        ToolTip="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Common_BrowseButtonTooltip]}" />
                </Grid>

                <Grid
                    Grid.Row="2"
                    Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox
                        Grid.Column="0"
                        Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Main_RecursiveLabel]}"
                        IsChecked="{Binding ViewModel.Recursive, Mode=TwoWay}" />
                    <ui:Button
                        Grid.Column="1"
                        Appearance="Primary"
                        Command="{Binding ViewModel.LoadCommand}"
                        Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Gallery_LoadButtonContent]}"
                        Icon="{ui:SymbolIcon ImageMultiple24}" />
                </Grid>
            </Grid>
        </Border>

        <!-- 一括タグ操作カード -->
        <Border
            Grid.Row="2"
            Margin="0,0,0,8"
            Padding="12"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,4"
                    FontSize="12"
                    Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Gallery_BulkTagSectionLabel]}" />
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:AutoSuggestBox
                        x:Name="SuggestTagName"
                        Grid.Column="0"
                        Height="36"
                        VerticalAlignment="Stretch"
                        PlaceholderText="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Gallery_BulkTagPlaceholder]}"
                        Text="{Binding ViewModel.BulkTagInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        OriginalItemsSource="{Binding ViewModel.TagList}">
                        <ui:AutoSuggestBox.Icon>
                            <ui:IconSourceElement>
                                <ui:SymbolIconSource Symbol="Search24" />
                            </ui:IconSourceElement>
                        </ui:AutoSuggestBox.Icon>
                    </ui:AutoSuggestBox>
                    <ui:Button
                        Grid.Column="1"
                        Height="36"
                        Margin="12,0,0,0"
                        Appearance="Secondary"
                        Command="{Binding ViewModel.BulkAddTagToStartCommand}"
                        Icon="{ui:SymbolIcon ArrowUp24}"
                        ToolTip="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Gallery_BulkAddToStartButtonContent]}" />
                    <ui:Button
                        Grid.Column="2"
                        Height="36"
                        Margin="12,0,0,0"
                        Appearance="Secondary"
                        Command="{Binding ViewModel.BulkAddTagCommand}"
                        Icon="{ui:SymbolIcon AddSquare24}"
                        ToolTip="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Gallery_BulkAddButtonContent]}" />
                    <ui:Button
                        Grid.Column="3"
                        Height="36"
                        Margin="12,0,0,0"
                        Appearance="Secondary"
                        Command="{Binding ViewModel.BulkRemoveTagCommand}"
                        Icon="{ui:SymbolIcon Delete24}"
                        ToolTip="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Gallery_BulkRemoveButtonContent]}">
                        <ui:Button.IsEnabled>
                            <MultiBinding Converter="{StaticResource TagExistsToBoolean}">
                                <Binding Path="ViewModel.BulkTagInput" />
                                <Binding Path="ViewModel.TagList" />
                                <Binding>
                                    <Binding.Source>
                                        <sys:Boolean>False</sys:Boolean>
                                    </Binding.Source>
                                </Binding>
                            </MultiBinding>
                        </ui:Button.IsEnabled>
                    </ui:Button>
                </Grid>
            </Grid>
        </Border>

        <!-- 読み込み中インジケーター -->
        <ProgressBar
            Grid.Row="3"
            Height="4"
            IsIndeterminate="True"
            Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- 状態メッセージ -->
        <TextBlock
            Grid.Row="4"
            Margin="0,8,0,0"
            HorizontalAlignment="Center"
            FontSize="14"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding ViewModel.StatusMessage, Mode=OneWay}"
            Visibility="{Binding ViewModel.StatusMessage, Converter={StaticResource StringToVisibilityConverter}}" />

        <!-- 画像・タグ一覧（左: 画像タイル一覧 / 右: 選択画像のタグ一覧・編集） -->
        <Grid Grid.Row="5" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="390" />
            </Grid.ColumnDefinitions>

            <!-- 左ペイン: 画像＋ファイル名のタイル一覧 -->
            <ScrollViewer
                Grid.Column="0"
                Margin="0,0,8,0"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl
                    ItemsSource="{Binding ViewModel.Images, Mode=OneWay}"
                    HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:GalleryImageEntry}">
                            <ToggleButton
                                Style="{StaticResource ImageTileToggleButtonStyle}"
                                Command="{Binding DataContext.ViewModel.SelectImageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                                <ToggleButton.IsChecked>
                                    <MultiBinding Converter="{StaticResource ObjectEqualsConverter}" Mode="OneWay">
                                        <Binding Path="." />
                                        <Binding Path="DataContext.ViewModel.SelectedImage" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                    </MultiBinding>
                                </ToggleButton.IsChecked>
                                <StackPanel Width="140" Orientation="Vertical">
                                    <Grid
                                        Width="140"
                                        Height="140"
                                        ClipToBounds="True">
                                        <!-- サムネイル（読み込み失敗時はプレースホルダーアイコン） -->
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <ui:SymbolIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="48"
                                            Foreground="{DynamicResource TextFillColorDisabledBrush}"
                                            Symbol="Image24">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                    </Grid>

                                    <!-- ファイル名 -->
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontWeight="Medium"
                                        Text="{Binding FileName}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding FileName}" />
                                </StackPanel>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 右ペイン: 選択中の画像のタグ一覧・編集 -->
            <Border
                Grid.Column="1"
                Padding="12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid DataContext="{Binding ViewModel.SelectedImage}">
                    <!-- 未選択時のプレースホルダー -->
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontStyle="Italic"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Gallery_SelectImagePrompt]}"
                        TextAlignment="Center"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 選択中の画像の詳細 -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- ファイル名 -->
                        <TextBlock
                            Grid.Row="0"
                            Margin="0,0,0,8"
                            FontWeight="Medium"
                            Text="{Binding FileName}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding FileName}" />

                        <!-- タグ一覧 -->
                        <ScrollViewer
                            Grid.Row="1"
                            PreviewMouseWheel="TagsScrollViewer_PreviewMouseWheel"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl
                                ItemsSource="{Binding Tags}"
                                Visibility="{Binding HasTags, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton
                                            Margin="0,0,4,4"
                                            Padding="8,2"
                                            Content="{Binding}"
                                            Command="{Binding DataContext.ToggleTagSelectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                            <ToggleButton.IsChecked>
                                                <MultiBinding Converter="{StaticResource TagInCollectionConverter}" Mode="OneWay">
                                                    <Binding Path="." />
                                                    <Binding Path="DataContext.SelectedTags" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                </MultiBinding>
                                            </ToggleButton.IsChecked>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock
                            Grid.Row="1"
                            FontSize="12"
                            FontStyle="Italic"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Gallery_NoTagsLabel]}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTags}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- タグ追加入力欄 -->
                        <Grid
                            Grid.Row="2"
                            Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:Button
                                Grid.Column="0"
                                Height="36"
                                Appearance="Secondary"
                                Command="{Binding CopyTagsToClipboardCommand}"
                                Icon="{ui:SymbolIcon Copy24}"
                                ToolTip="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Gallery_CopyTagsTooltip]}"/>
                            <ui:TextBox
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Height="36"
                                FontSize="12"
                                PlaceholderText="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Gallery_AddTagPlaceholder]}"
                                Text="{Binding NewTagInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ui:TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AddNewTagCommand}" />
                                </ui:TextBox.InputBindings>
                            </ui:TextBox>
                            <ui:Button
                                Grid.Column="2"
                                Width="36"
                                Height="36"
                                Margin="8,0,0,0"
                                Appearance="Secondary"
                                Command="{Binding AddNewTagToStartCommand}"
                                Icon="{ui:SymbolIcon ArrowUp24}"
                                ToolTip="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Gallery_AddTagToStartTooltip]}">
                                <ui:Button.IsEnabled>
                                    <MultiBinding Converter="{StaticResource TagExistsToBoolean}">
                                        <Binding Path="NewTagInput" />
                                        <Binding Path="Tags" />
                                        <Binding>
                                            <Binding.Source>
                                                <sys:Boolean>True</sys:Boolean>
                                            </Binding.Source>
                                        </Binding>
                                    </MultiBinding>
                                </ui:Button.IsEnabled>
                            </ui:Button>
                            <ui:Button
                                Grid.Column="3"
                                Width="36"
                                Height="36"
                                Margin="8,0,0,0"
                                Appearance="Secondary"
                                Command="{Binding AddNewTagCommand}"
                                Icon="{ui:SymbolIcon AddCircle24}"
                                ToolTip="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Gallery_AddTagToEndTooltip]}">
                                <ui:Button.IsEnabled>
                                    <MultiBinding Converter="{StaticResource TagExistsToBoolean}">
                                        <Binding Path="NewTagInput" />
                                        <Binding Path="Tags" />
                                        <Binding>
                                            <Binding.Source>
                                                <sys:Boolean>True</sys:Boolean>
                                            </Binding.Source>
                                        </Binding>
                                    </MultiBinding>
                                </ui:Button.IsEnabled>
                            </ui:Button>
                            <ui:Button
                                Grid.Column="4"
                                Width="36"
                                Height="36"
                                Margin="8,0,0,0"
                                Appearance="Secondary"
                                Command="{Binding RemoveSelectedTagsCommand}"
                                Icon="{ui:SymbolIcon Delete24}"
                                ToolTip="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Gallery_RemoveTagTooltip]}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
