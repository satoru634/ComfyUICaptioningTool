<Page
    x:Class="ComfyUICaptioningTool.Views.Pages.ReportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:ComfyUICaptioningTool.Helpers"
    xmlns:local="clr-namespace:ComfyUICaptioningTool.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:helper="clr-namespace:ComfyUICaptioningTool.Helpers"
    Title="ReportPage"
    d:DataContext="{d:DesignInstance local:ReportPage, IsDesignTimeCreatable=False}"
    d:DesignHeight="800"
    d:DesignWidth="1000"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">

    <Page.Resources>
        <helper:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Page.Resources>

    <Grid Margin="16,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- タイトル -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,12"
            FontSize="20"
            FontWeight="SemiBold"
            Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Report_Title]}" />

        <Border
            Grid.Row="1"
            Padding="12"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,4"
                    FontSize="12"
                    Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Main_DirectoryLabel]}" />
                <Grid
                    Grid.Row="1"
                    Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:TextBox
                        Grid.Column="0"
                        Height="36"
                        IsReadOnly="True"
                        PlaceholderText="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Main_DirectoryPlaceholder]}"
                        Text="{Binding ViewModel.ReportDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button
                        Grid.Column="1"
                        Width="36"
                        Height="36"
                        Margin="12,0,0,0"
                        Appearance="Secondary"
                        Command="{Binding ViewModel.BrowseReportDirectoryCommand}"
                        Icon="{ui:SymbolIcon FolderOpen16}"
                        ToolTip="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Common_BrowseButtonTooltip]}" />
                </Grid>

                <Grid
                    Grid.Row="2"
                    Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox
                        Grid.Column="0"
                        Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Main_RecursiveLabel]}"
                        IsChecked="{Binding ViewModel.ReportRecursive, Mode=TwoWay}" />
                    <ui:Button
                        Grid.Column="1"
                        Appearance="Primary"
                        Command="{Binding ViewModel.GenerateReportCommand}"
                        Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Report_GenerateReportButton]}"
                        Icon="{ui:SymbolIcon DataHistogram24}" />
                </Grid>

                <TextBlock
                    Grid.Row="3"
                    Margin="0,0,0,8"
                    FontSize="12"
                    Text="{Binding ViewModel.ReportStatusText, Mode=OneWay}"
                    Visibility="{Binding ViewModel.ReportStatusText, Converter={StaticResource StringToVisibilityConverter}}"/>
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="8,8,0,8"
                        HorizontalAlignment="Left"
                        Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Report_TagColumnHeader]}"
                        VerticalAlignment="Center"
                        FontWeight="Bold" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="0,8,8,8"
                        HorizontalAlignment="Left"
                        Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Report_CountColumnHeader]}"
                        VerticalAlignment="Center"
                        FontWeight="Bold" />
                </Grid>
                <Border
                    Grid.Row="5"
                    Padding="0"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <ui:ListView
                        BorderThickness="0"
                        ItemsSource="{Binding ViewModel.ReportEntries, Mode=OneWay}"
                        SelectionMode="Single"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ui:ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="4,4,0,4"
                                        HorizontalAlignment="Left"
                                        Text="{Binding Tag}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="0,4,4,4"
                                        HorizontalAlignment="Left"
                                        Text="{Binding Count}" />
                                </Grid>
                            </DataTemplate>
                        </ui:ListView.ItemTemplate>
                    </ui:ListView>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
