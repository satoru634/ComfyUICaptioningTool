<Page
    x:Class="ComfyUICaptioningTool.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:ComfyUICaptioningTool.Helpers"
    xmlns:local="clr-namespace:ComfyUICaptioningTool.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="SettingsPage"
    d:DataContext="{d:DesignInstance local:SettingsPage, IsDesignTimeCreatable=False}"
    d:DesignHeight="800"
    d:DesignWidth="1000"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,8,16,16">

            <!-- タイトル -->
            <TextBlock
                Margin="0,0,0,12"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Settings_Title]}" />

            <!-- 表示 -->
            <TextBlock
                Margin="0,0,0,4"
                FontSize="14"
                FontWeight="Medium"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Settings_DisplaySectionLabel]}" />
            <Border
                Margin="0,0,0,4"
                Padding="12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Symbol="DarkTheme24" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Settings_ThemeLabel]}" />
                    <ComboBox
                        Grid.Column="2"
                        Width="200"
                        ItemsSource="{Binding ViewModel.ThemeList, Mode=OneWay}"
                        SelectedItem="{Binding ViewModel.SelectedTheme, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- 言語 -->
            <Border
                Margin="0,0,0,12"
                Padding="12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Symbol="LocalLanguage24" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Settings_LanguageLabel]}" />
                    <ComboBox
                        Grid.Column="2"
                        Width="200"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding ViewModel.LanguageList}"
                        SelectedValue="{Binding ViewModel.SelectedLanguage, Mode=TwoWay}"
                        SelectedValuePath="Key" />
                </Grid>
            </Border>

            <!-- バージョン -->
            <TextBlock Margin="8,4,8,4" FontSize="16" FontWeight="Medium" Text="About" />
            <TextBlock Margin="8,4,8,4" Text="{Binding ViewModel.AppVersion, Mode=OneWay}" />
            <ui:ImageIcon
                Margin="8,4,8,4"
                Width="128"
                Height="128"
                Source="pack://application:,,,/Assets/wpfui-icon-256.png" HorizontalAlignment="Left"/>

        </StackPanel>
    </ScrollViewer>
</Page>
