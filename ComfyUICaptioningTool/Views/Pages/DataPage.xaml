<Page
    x:Class="ComfyUICaptioningTool.Views.Pages.DataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:ComfyUICaptioningTool.Helpers"
    xmlns:local="clr-namespace:ComfyUICaptioningTool.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:helper="clr-namespace:ComfyUICaptioningTool.Helpers"
    Title="DataPage"
    d:DataContext="{d:DesignInstance local:DataPage, IsDesignTimeCreatable=False}"
    d:DesignHeight="800"
    d:DesignWidth="1000"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">

    <Page.Resources>
        <helper:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Page.Resources>

    <Grid Margin="16,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- タイトル -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,12"
            FontSize="20"
            FontWeight="SemiBold"
            Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Data_Title]}" />

        <!-- 直近の実行結果 -->
        <TextBlock
            Grid.Row="1"
            Margin="0,0,0,4"
            FontSize="14"
            FontWeight="Medium"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Data_LastResultSectionLabel]}" />
        <Border
            Grid.Row="2"
            Padding="12"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,4"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding ViewModel.LastResultDirectory, Mode=OneWay}"
                    Visibility="{Binding ViewModel.LastResultDirectory, Converter={StaticResource StringToVisibilityConverter}}" />
                <TextBlock
                    Grid.Row="1"
                    Margin="0,0,0,4"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding ViewModel.LastResultTimestampText, Mode=OneWay}"
                    Visibility="{Binding ViewModel.LastResultTimestampText, Converter={StaticResource StringToVisibilityConverter}}" />
                <TextBlock
                    Grid.Row="2"
                    Margin="0,0,0,8"
                    FontWeight="Medium"
                    Text="{Binding ViewModel.LastResultSummary, Mode=OneWay}"
                    Visibility="{Binding ViewModel.LastResultSummary, Converter={StaticResource StringToVisibilityConverter}}" />
                <Border
                    Grid.Row="3"
                    Padding="4"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <ListBox
                        BorderThickness="0"
                        ItemsSource="{Binding ViewModel.LastResultLogEntries, Mode=OneWay}"
                        ScrollViewer.CanContentScroll="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
