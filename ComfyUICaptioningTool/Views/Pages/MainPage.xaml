<Page
  x:Class="ComfyUICaptioningTool.Views.Pages.MainPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:helpers="clr-namespace:ComfyUICaptioningTool.Helpers"
  xmlns:local="clr-namespace:ComfyUICaptioningTool.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="MainPage"
  d:DataContext="{d:DesignInstance local:MainPage,
                                     IsDesignTimeCreatable=False}"
  d:DesignHeight="700"
  d:DesignWidth="1000"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Page.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16,8,16,16">

      <!-- タイトル -->
      <TextBlock
        Margin="0,0,0,12"
        FontSize="20"
        FontWeight="SemiBold"
        Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Main_Title]}" />

      <!-- 対象ディレクトリ -->
      <Border
        Margin="0,0,0,12"
        Padding="12"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="4">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ui:SymbolIcon
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,0,8,0"
            VerticalAlignment="Center"
            Symbol="Folder24" />
          <TextBlock
            Grid.Row="0"
            Grid.Column="1"
            VerticalAlignment="Center"
            FontSize="14"
            Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Main_DirectoryLabel]}" />
          <StackPanel
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,8,0,0"
            Orientation="Horizontal">
            <ui:TextBox
              Width="700"
              Height="36"
              Margin="0,0,4,0"
              IsReadOnly="True"
              PlaceholderText="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Main_DirectoryPlaceholder]}"
              Text="{Binding ViewModel.TargetDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button
              Width="36"
              Height="36"
              Margin="4,0,0,0"
              Appearance="Secondary"
              Command="{Binding ViewModel.BrowseDirectoryCommand}"
              Icon="{ui:SymbolIcon FolderOpen16}"
              ToolTip="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Common_BrowseButtonTooltip]}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- オプション -->
      <TextBlock
        Margin="0,0,0,4"
        FontSize="14"
        FontWeight="Medium"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Main_OptionsSectionLabel]}" />
      <Border
        Margin="0,0,0,12"
        Padding="12"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="4">
        <StackPanel>
          <CheckBox
            Margin="0,0,0,8"
            Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Main_RecursiveLabel]}"
            IsChecked="{Binding ViewModel.Recursive, Mode=TwoWay}" FontSize="13" />
          <CheckBox
            Margin="0,0,0,8"
            Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Main_OverwriteLabel]}"
            IsChecked="{Binding ViewModel.Overwrite, Mode=TwoWay}" FontSize="13" />
          <CheckBox
            Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Main_GenerateReportLabel]}"
            IsChecked="{Binding ViewModel.GenerateReport, Mode=TwoWay}" FontSize="13" />
        </StackPanel>
      </Border>

      <!-- タグフィルタ -->
      <TextBlock
        Margin="0,0,0,4"
        FontSize="14"
        FontWeight="Medium"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Main_TagsSectionLabel]}" />
      <Border
        Margin="0,0,0,12"
        Padding="12"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="4">
        <StackPanel>
          <TextBlock
            Margin="0,0,0,4"
            FontSize="12"
            Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Main_PrependTagsLabel]}" />
          <ui:TextBox
            Height="36"
            Margin="0,0,0,12"
            PlaceholderText="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Main_TagsPlaceholder]}"
            Text="{Binding ViewModel.PrependTagsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock
            Margin="0,0,0,4"
            FontSize="12"
            Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Main_ExcludeTagsLabel]}" />
          <ui:TextBox
            Height="36"
            PlaceholderText="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Main_TagsPlaceholder]}"
            Text="{Binding ViewModel.ExcludeTagsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </Border>

      <!-- 実行 -->
      <ui:Button
        Margin="0,0,0,12"
        Appearance="Primary"
        Command="{Binding ViewModel.RunCommand}"
        Content="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Main_RunButton]}"
        Icon="{ui:SymbolIcon PlayCircle24}" />

      <ProgressBar
        Height="4"
        Margin="0,0,0,4"
        Maximum="{Binding ViewModel.ProgressTotal, Mode=OneWay}"
        Value="{Binding ViewModel.ProgressCurrent, Mode=OneWay}"
        Visibility="{Binding ViewModel.HasProgress, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
      <TextBlock
        Margin="0,0,0,4"
        FontSize="12"
        Text="{Binding ViewModel.ProgressText, Mode=OneWay}" />
      <TextBlock
        Margin="0,0,0,12"
        FontWeight="Medium"
        Text="{Binding ViewModel.SummaryText, Mode=OneWay}" />

      <!-- ログ -->
      <TextBlock
        Margin="0,0,0,4"
        FontSize="14"
        FontWeight="Medium"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Main_LogHeader]}" />
      <Border
        Padding="4"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="4">
        <ListBox
          Height="240"
          BorderThickness="0"
          ItemsSource="{Binding ViewModel.LogEntries, Mode=OneWay}"
          ScrollViewer.VerticalScrollBarVisibility="Auto" />
      </Border>

    </StackPanel>
  </ScrollViewer>
</Page>
